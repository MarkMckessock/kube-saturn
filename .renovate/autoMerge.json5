{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Auto-merge trusted container digests",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge first-party image digests",
      // Images built from our own repos, whose CI has already tested the commit that
      // produced them, so these are proposed with no release-age delay.
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/^ghcr\\.io\\/markmckessock\\//"],
      minimumReleaseAge: "0 minutes",
      ignoreTests: false,
    },
    {
      description: "Auto-merge OCI Charts",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/", "/grafana/"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: [
        "/^actions\//",
        "/^renovatebot\//",
      ],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "1 minute",
      ignoreTests: false,
    },
    {
      description: "Auto-merge GitHub Releases",
      // These ship CRDs, so they change the rendered cluster and must clear the render checks.
      matchDatasources: ["github-releases"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/external-dns/", "/gateway-api/", "/prometheus-operator/"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge patch updates",
      matchUpdateTypes: ["patch"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge minor updates",
      matchUpdateTypes: ["minor"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Review minors for core infrastructure",
      matchUpdateTypes: ["minor"],
      matchPackageNames: [
        "/cilium/",
        "/rook/",
        "/envoyproxy/",
        "/external-secrets/",
        "/flux-operator/",
        "/flux-instance/",
        "/cloudnative-pg/",
        "/openebs/",
        "/coredns/",
        "/cert-manager/",
        "/spegel/",
        "/tuppr/",
        "/intel/",
        "/snapshot-controller/",
        "/siderolabs/",
        "/factory\\.talos\\.dev/",
        "/registry\\.k8s\\.io\\/kube-/",
      ],
      automerge: false,
    },
    {
      description: "Review Talos and Kubernetes patches, which roll node reboots",
      matchUpdateTypes: ["patch"],
      matchPackageNames: [
        "/siderolabs/",
        "/factory\\.talos\\.dev/",
        "/registry\\.k8s\\.io\\/kube-/",
      ],
      automerge: false,
    },
    {
      description: "Never auto-merge majors, even once approved",
      matchUpdateTypes: ["major"],
      automerge: false,
    },
  ],
}
