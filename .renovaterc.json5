{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>MarkMckessock/kube-saturn//.renovate/autoMerge.json5",
    "github>MarkMckessock/kube-saturn//.renovate/changelogs.json5",
    "github>MarkMckessock/kube-saturn//.renovate/customManagers.json5",
    "github>MarkMckessock/kube-saturn//.renovate/grafanaDashboards.json5",
    "github>MarkMckessock/kube-saturn//.renovate/groups.json5",
    "github>MarkMckessock/kube-saturn//.renovate/labels.json5",
    "github>MarkMckessock/kube-saturn//.renovate/overrides.json5",
    "github>MarkMckessock/kube-saturn//.renovate/semanticCommits.json5",
    ":automergeBranch",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(America/New_York)",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  prConcurrentLimit: 10,
  prHourlyLimit: 4,
  minimumReleaseAge: "3 days",
  packageRules: [
    {
      description: "Hold majors behind dashboard approval",
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      description: "Skip pre-release container tags",
      matchDatasources: ["docker"],
      ignoreUnstable: true,
    },
  ],
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [
    "**/*.sops.*",
    "**/resources/**",
  ],
  flux: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
}